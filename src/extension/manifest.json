{
  "manifest_version": 3,
  "name": "ChangeWatch - 1-Click Monitor",
  "version": "1.0.0",
  "description": "Add any webpage to ChangeWatch change detection with a single click.",
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Add to ChangeWatch"
  },
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
