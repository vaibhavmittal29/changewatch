# Server & URLs
PORT=3000
BASE_URL=http://localhost:3000

# Security (32+ random characters)
APP_SECRET=changewatch_super_secure_random_key_min_32_chars_long_2026

# Storage
DATABASE_PATH=./data/changewatch.db
DATA_DIR=./data

# User-Agent Contact Email
CONTACT_EMAIL=student@vit.ac.in

# Cryptography (use 1000 in tests/dev for fast execution, 600000 in prod)
PBKDF2_ITERATIONS=1000

# Scheduling & Politeness
TICK_MS=30000
WORKER_CONCURRENCY=3
DOMAIN_GAP_MS=10000
CONFIRM_DELAY_MS=120000
SHARED_CAPTURE_TTL_MS=15000
COOLDOWN_HOURS=6
OUTAGE_THRESHOLD=3
MAX_SUBS_PER_USER=25
OBSERVATION_RETENTION_DAYS=30
DIGEST_HOUR=9

# Local Demo Server (port 4000)
ALLOW_LOCAL_DEMO=true
DEMO_PORT=4000
DEV_MIN_INTERVAL_MINUTES=1

# Optional Integrations
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
GEMINI_API_KEY=
