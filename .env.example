# Server & URLs
PORT=3000
BASE_URL=http://localhost:3000

# Security (Production requires 32+ high-entropy random characters; never use default/sample values)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# Storage
DATABASE_PATH=./data/changewatch.db
DATA_DIR=./data

# User-Agent Contact Email
CONTACT_EMAIL=student@vit.ac.in

# Cryptography (Standard 600,000 PBKDF2 iterations in production; 1000 in local dev/tests)
PBKDF2_ITERATIONS=600000

# Scheduling & Politeness
TICK_MS=30000
WORKER_CONCURRENCY=3
DOMAIN_GAP_MS=10000
CONFIRM_DELAY_MS=120000
SHARED_CAPTURE_TTL_MS=15000
COOLDOWN_HOURS=6
OUTAGE_THRESHOLD=3
MAX_SUBS_PER_USER=25
OBSERVATION_RETENTION_DAYS=30
DIGEST_HOUR=9

# Local Demo Server (port 4000; listens only on 127.0.0.1; disabled by default)
ALLOW_LOCAL_DEMO=false
DEMO_PORT=4000

# Development Overrides (Uncomment only during local development testing)
# DEV_MIN_INTERVAL_MINUTES=1

# Optional Integrations
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
GEMINI_API_KEY=
