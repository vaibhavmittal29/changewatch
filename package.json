{
  "name": "changewatch",
  "version": "1.0.0",
  "description": "Website Change Detector — headless browser monitoring with intelligent noise suppression and multi-channel alerting",
  "author": "Vaibhav Mittal <vaibhavmittalwork@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vaibhavmittal29/changewatch.git"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build": "tsc -b && vite build",
    "start": "tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" --max-warnings 0",
    "test": "vitest run",
    "seed": "tsx scripts/seed.ts",
    "capture": "tsx scripts/capture.ts",
    "smoke": "tsx scripts/smoke.ts",
    "smoke:prod": "tsx scripts/prodSmoke.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "verify": "tsx scripts/verify.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "cheerio": "^1.0.0",
    "cookie-parser": "^1.4.7",
    "diff": "^7.0.0",
    "dotenv": "^16.4.7",
    "express": "^5.0.1",
    "express-rate-limit": "^7.5.0",
    "ipaddr.js": "^2.2.0",
    "nodemailer": "^6.10.0",
    "pixelmatch": "^7.1.0",
    "playwright": "^1.50.1",
    "pngjs": "^7.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "robots-parser": "^3.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cookie-parser": "^1.4.8",
    "@types/diff": "^7.0.2",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/nodemailer": "^6.4.17",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.20.1",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
